<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:chat="using:Client.ViewModels.Chat"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Client.Views.Chat.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Chat.ChatView"
             x:DataType="chat:ChatViewModel">
    <Border Background="LightYellow"
            Padding="10">
        <Grid>
            <Grid RowDefinitions="100,*" ColumnDefinitions="Auto, *, Auto">
                <views:InvitationsPanelView Grid.Row="0" Grid.Column="0"
                                            DataContext="{Binding InvitationsPanel}"
                                            IsVisible="{Binding $parent[UserControl].DataContext.IsChatVisible}"/>
                <views:MainPanelView Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     DataContext="{Binding MainPanel}"
                                     IsVisible="{Binding $parent[UserControl].DataContext.IsChatVisible}"/>
                <views:RoomsPanelView Grid.Row="1" Grid.Column="0"
                                      DataContext="{Binding RoomsPanel}"
                                      IsVisible="{Binding $parent[UserControl].DataContext.IsChatVisible}"/>
                <views:ChatPanelView Grid.Row="1" Grid.Column="1" 
                                     DataContext="{Binding ChatPanel}"
                                     IsVisible="{Binding $parent[UserControl].DataContext.IsChatVisible}"/>
                <views:UsersPanelView Grid.Row="1" Grid.Column="2"
                                      DataContext="{Binding UsersPanel}"
                                      IsVisible="{Binding $parent[UserControl].DataContext.IsChatVisible}"/>
            </Grid>
            <views:InviteUserPanelView DataContext="{Binding InviteUserPanel}"/>
        </Grid>
        
    </Border>
</UserControl>
