<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:chat="using:Client.ViewModels.Chat"
             xmlns:components="using:Client.Views.Chat.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Chat.ChatView"
             x:DataType="chat:ChatViewModel"
             Background="White">
      <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, *, Auto" Margin="10">
          <components:TopPanel Grid.Row="0" Grid.ColumnSpan="3"/>
          <components:RoomsPanel Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"/>
          <components:ChatPanel Grid.Row="1" Grid.Column="1"/>
          <components:UsersPanel Grid.Row="1" Grid.Column="2" Grid.RowSpan="2"/>
          <components:TextPanel Grid.Row="2" Grid.Column="1"/>
      </Grid>
</UserControl>
