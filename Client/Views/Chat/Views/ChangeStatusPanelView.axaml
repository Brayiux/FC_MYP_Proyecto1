<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="using:Client.ViewModels.Chat.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.Chat.Views.ChangeStatusPanelView"
             x:DataType="viewmodels:ChangeStatusPanelViewModel"
             Height="200"
             Width="200">
    <Border Background="Gray"
            CornerRadius="10"
            Padding="15">
        <Grid RowDefinitions="Auto, Auto" RowSpacing="10">
            <TextBlock Grid.Row="0"
                       Text="Cambiar de estado"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1"
                       Text="Seleccione el estado al cual desea transicionar:"
                       TextWrapping="Wrap"/>
            <ComboBox Grid.Row="2">
                
            </ComboBox>
        </Grid>
    </Border>
</UserControl>
